# URL des n8n-Webhooks, der Wilson-Nachrichten verarbeitet.
# WICHTIG: Diese URL darf niemals im Client-Code auftauchen. Sie wird
# ausschließlich serverseitig in app/api/wilson/route.ts verwendet.
WILSON_WEBHOOK_URL=https://n8n.srv1410863.hstgr.cloud/webhook/wilson

# Calendly-Terminlink für die Terminbuchung im Chat.
# NEXT_PUBLIC_, weil der Button clientseitig das Calendly-Popup öffnet –
# das ist unbedenklich, da es sich um einen öffentlichen Buchungslink handelt.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/leifgoroll/30min

# Optional: n8n-Webhook, der diktierte Transkripte bereinigt (Füllwörter,
# Dopplungen, Grammatik – z. B. per LLM-Node). Wenn nicht gesetzt, läuft
# stattdessen eine einfache lokale Heuristik. Serverseitig only, siehe
# app/api/wilson/transcript/route.ts.
# WILSON_TRANSCRIPT_WEBHOOK_URL=https://n8n.srv1410863.hstgr.cloud/webhook/wilson-transcript

# --- Sprachmodus (LiveAvatar / HeyGen) ----------------------------------
# API-Key aus dem LiveAvatar-Konto. NUR serverseitig verwenden: Mit diesem
# Key lassen sich Credits verbrauchen (LITE-Modus 1 Credit ≈ 1 Minute).
# Niemals NEXT_PUBLIC_ voranstellen.
# HEYGEN_API_KEY=

# ID des Avatars, den LiveAvatar streamen soll. Ermitteln mit:
#   node --env-file=.env.local scripts/check-heygen.mjs
# Erst wenn BEIDE Werte gesetzt sind, bietet das Widget "Sprechen" an.
# LIVEAVATAR_AVATAR_ID=

# Sprachausgabe für den Sprachmodus. LiveAvatar liefert im LITE-Modus keine
# Stimme, deshalb erzeugt OpenAI das Audio (PCM 24 kHz, exakt das Format,
# das LiveAvatar erwartet). Serverseitig only.
# OPENAI_API_KEY=
# Optional – Standard: gpt-4o-mini-tts / coral
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# Obergrenze je Sprachsitzung in Sekunden (Standard 120). Schützt die
# Credits, falls jemand den Tab offen liegen lässt. Free-Plan kappt bei 120.
# LIVEAVATAR_MAX_SESSION_SECONDS=120

# Greenscreen des Avatars im Browser ausstanzen (Canvas, kostet Rechenzeit
# pro Bild). Nur nötig bei Avataren ohne eigenen Hintergrund. Die
# Sitting-Presets streamen mit echtem Raum – dann auf false lassen.
# LIVEAVATAR_CHROMA_KEY=false

# Anbieter der Sprachausgabe: "openai" (Standard) oder "gemini".
# Beide liefern PCM 24 kHz – genau LiveAvatars Format, kein Umrechnen.
# TTS_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
