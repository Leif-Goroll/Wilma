# URL des n8n-Webhooks, der Wilson-Nachrichten verarbeitet.
# WICHTIG: Diese URL darf niemals im Client-Code auftauchen. Sie wird
# ausschließlich serverseitig in app/api/wilson/route.ts verwendet.
WILSON_WEBHOOK_URL=https://n8n.srv1410863.hstgr.cloud/webhook/wilson

# Calendly-Terminlink für die Terminbuchung im Chat.
# NEXT_PUBLIC_, weil der Button clientseitig das Calendly-Popup öffnet –
# das ist unbedenklich, da es sich um einen öffentlichen Buchungslink handelt.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/leifgoroll/30min

# Optional: n8n-Webhook, der diktierte Transkripte bereinigt (Füllwörter,
# Dopplungen, Grammatik – z. B. per LLM-Node). Wenn nicht gesetzt, läuft
# stattdessen eine einfache lokale Heuristik. Serverseitig only, siehe
# app/api/wilson/transcript/route.ts.
# WILSON_TRANSCRIPT_WEBHOOK_URL=https://n8n.srv1410863.hstgr.cloud/webhook/wilson-transcript

# --- Sprachmodus (LiveAvatar / HeyGen) ----------------------------------
# API-Key aus dem LiveAvatar-Konto. NUR serverseitig verwenden: Mit diesem
# Key lassen sich Credits verbrauchen (LITE-Modus 1 Credit ≈ 1 Minute).
# Niemals NEXT_PUBLIC_ voranstellen.
# HEYGEN_API_KEY=

# ID des Avatars, den LiveAvatar streamen soll. Ermitteln mit:
#   node --env-file=.env.local scripts/check-heygen.mjs
# Erst wenn BEIDE Werte gesetzt sind, bietet das Widget "Sprechen" an.
# LIVEAVATAR_AVATAR_ID=

# Sprachausgabe für den Sprachmodus. LiveAvatar liefert im LITE-Modus keine
# Stimme, deshalb erzeugt OpenAI das Audio (PCM 24 kHz, exakt das Format,
# das LiveAvatar erwartet). Serverseitig only.
# OPENAI_API_KEY=
# Optional – Standard: gpt-4o-mini-tts / coral
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# Obergrenze je Sprachsitzung in Sekunden (Standard 120). Schützt die
# Credits, falls jemand den Tab offen liegen lässt. Free-Plan kappt bei 120.
# LIVEAVATAR_MAX_SESSION_SECONDS=120

# Greenscreen des Avatars im Browser ausstanzen (Canvas, kostet Rechenzeit
# pro Bild). Nur nötig bei Avataren ohne eigenen Hintergrund. Die
# Sitting-Presets streamen mit echtem Raum – dann auf false lassen.
# LIVEAVATAR_CHROMA_KEY=false

# Anbieter der Sprachausgabe: "openai" (Standard) oder "gemini".
# Beide liefern PCM 24 kHz – genau LiveAvatars Format, kein Umrechnen.
# TTS_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# ElevenLabs – empfohlener Anbieter (gemessen 0,35 s statt 1,4 s bei OpenAI,
# halber Zeichenpreis mit Turbo/Flash). Ist der Key gesetzt und
# TTS_PROVIDER leer, wird ElevenLabs automatisch verwendet.
# ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# Stimme "Sarah – Storyteller" (muttersprachlich deutsch).
# Alternativen: Susi v3V1d2rk6528UrLKRuy8, Laura zKHQdbB8oaQ7roNTiDTK,
# Ramona 6CS8keYmkwxkspesdyA7, Louisa 1iF3vHdwHKuVKSPDK23Z,
# Lucy KXxZd16DiBqt82nbarJx
# ELEVENLABS_VOICE_ID=XtxuRNfvtd45OyWcp5jr

# --- Einbettung auf einer fremden Seite (WordPress) ----------------------
# Wer darf Wilma per iframe einbetten? Kommagetrennte Liste, ohne Pfad.
# Leer oder nicht gesetzt heißt: jede Seite darf es. Zum Ausprobieren in
# Ordnung, auf Dauer nicht – sonst baut ein Fremder das Widget auf seiner
# Seite ein und verbraucht dabei Ihre LiveAvatar-Credits.
# WILMA_ALLOWED_ORIGINS=https://ihre-firma.de,https://www.ihre-firma.de

# --- Dashboard und Auswertung -------------------------------------------
# Das Dashboard liegt unter /dashboard und liest aus derselben
# Supabase-Datenbank, in der schon Wilmas Wissensbasis steht.
#
# Der Schlüssel muss der geheime sein (Supabase → Project Settings →
# API Keys → "service_role" bzw. "secret"). Er umgeht die Zeilensicherheit
# und darf deshalb ausschließlich serverseitig stehen – niemals mit
# NEXT_PUBLIC_ davor, niemals ins Frontend.
#
# Fehlen die beiden Werte, läuft Wilma unverändert weiter; es wird dann
# nur nichts mitgeschrieben.
SUPABASE_URL=https://ihr-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kennwort für Ihre Gesamtsicht über alle Kunden. Ohne dieses Kennwort
# kann sich niemand am Dashboard anmelden – auch niemand Fremdes.
DASHBOARD_PASSWORD=

# Optional: eigener Schlüssel zum Signieren des Anmelde-Cookies. Fehlt er,
# wird DASHBOARD_PASSWORD verwendet – dann macht ein neues Kennwort alle
# bestehenden Anmeldungen ungültig, was meistens gewollt ist.
# DASHBOARD_SECRET=

# Optional: feste Kundenkennung für die eigene Website. Ohne sie ordnet
# der Server anhand der Domain zu, unter der Wilma eingebunden ist.
# NEXT_PUBLIC_WILMA_CLIENT=future-ai
